# /etc/systemd/system/ad-ui.service — на VPS с панелью управления
# Секреты: /opt/ad-streamer/ui.env (chmod 600, владелец adstreamer), формат:
#   AGENT_URL=http://10.0.0.10:8500
#   API_KEY=...
#   UI_DATA=/opt/ad-streamer/ui-data
#   ADMIN_PASSWORD=...    (используется один раз при пустой БД пользователей)
#   HLS_UPSTREAM=http://10.0.0.10:8080   (запасной Flussonic-HLS для плеера,
#                                             если у агента не заполнен hls_url)
#
# Подготовка пользователя (один раз):
#   useradd -r -d /opt/ad-streamer -s /usr/sbin/nologin adstreamer
#   chown -R adstreamer:adstreamer /opt/ad-streamer
[Unit]
Description=ad-streamer UI (web panel + proxy to agents)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=adstreamer
Group=adstreamer
WorkingDirectory=/opt/ad-streamer/ui
EnvironmentFile=/opt/ad-streamer/ui.env
ExecStart=/opt/ad-streamer/venv/bin/uvicorn server:app --host 0.0.0.0 --port 8080
Restart=always
RestartSec=3
# hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/ad-streamer

[Install]
WantedBy=multi-user.target
