# /etc/systemd/system/ad-agent.service — на сервере с Flussonic
# Секреты: /opt/ad-streamer/agent.env (chmod 600, владелец adstreamer), формат:
#   API_KEY=...
#   DATA_DIR=/opt/ad-streamer/data
#   HOME=/opt/ad-streamer
#   PLAYWRIGHT_BROWSERS_PATH=/opt/ad-streamer/ms-playwright
#
# Подготовка пользователя (один раз):
#   useradd -r -d /opt/ad-streamer -s /usr/sbin/nologin adstreamer
#   PLAYWRIGHT_BROWSERS_PATH=/opt/ad-streamer/ms-playwright \
#     /opt/ad-streamer/venv/bin/playwright install chromium
#   chown -R adstreamer:adstreamer /opt/ad-streamer
[Unit]
Description=ad-streamer agent (ffmpeg mixers + banners + scheduler)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=adstreamer
Group=adstreamer
WorkingDirectory=/opt/ad-streamer/agent
EnvironmentFile=/opt/ad-streamer/agent.env
ExecStart=/opt/ad-streamer/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8500
Restart=always
RestartSec=3
KillMode=mixed
# hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/ad-streamer

[Install]
WantedBy=multi-user.target
